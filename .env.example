# Discord bot application
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# Leave blank for global slash commands
GUILD_ID=

# Persistent Kimi data
DATA_DIR=data
LOG_LEVEL=info

# Termux-hosted dashboard (keep local; expose it through an HTTPS tunnel)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Kimi account authentication uses local JSON files in DATA_DIR/auth.
# Keep secure cookies enabled when the dashboard is accessed through an HTTPS tunnel.
DASHBOARD_COOKIE_SECURE=true

# Discord user ID allowed to view process-wide runtime logs
DASHBOARD_OWNER_ID=
