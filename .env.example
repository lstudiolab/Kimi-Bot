DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_discord_application_id
DATA_DIR=data
LOG_LEVEL=info

# Optional Swift dashboard. Configure Discord OAuth2 in the Developer Portal.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DISCORD_OAUTH_CLIENT_SECRET=your_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=https://your-public-host/oauth/callback
