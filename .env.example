# Discord bot application
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# Leave blank for global slash commands
GUILD_ID=

# Persistent Kimi data
DATA_DIR=data
LOG_LEVEL=info

# Termux-hosted dashboard (keep local; expose it through an HTTPS tunnel)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Discord OAuth2 for /verify and dashboard sign-in
# Create an OAuth2 redirect URI in the Discord Developer Portal:
# https://your-public-host/auth/discord/callback
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# Automatically true when the OAuth redirect URI uses HTTPS.
DASHBOARD_COOKIE_SECURE=true

# Discord user ID allowed to view process-wide runtime logs
DASHBOARD_OWNER_ID=
